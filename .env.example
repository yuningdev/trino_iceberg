# ---------------------------------------------------------------------------
# Trino playground - single source of truth for versions, ports, credentials
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=trino-playground

# --- image versions -------------------------------------------------------
TRINO_VERSION=484
HIVE_METASTORE_VERSION=standalone-metastore-4.2.1
POSTGRES_VERSION=16-alpine
# MinIO: minio/minio and minio/mc were withdrawn from Docker Hub (and
# quay.io/minio/* now needs credentials), so we pull Bitnami's archived builds
# of the same releases. 2025.4.22 == RELEASE.2025-04-22T22-12-26Z, the last
# community release that still ships the web console UI.
MINIO_IMAGE=bitnamilegacy/minio
MINIO_VERSION=2025.4.22
MC_IMAGE=bitnamilegacy/minio-client
MC_VERSION=2025.4.16
POLARIS_VERSION=1.8.0
# PySpark playground (./pyspark) - independent of Trino/HMS, see
# pyspark/iceberg/create_and_load.py for why. hadoop-aws/aws-sdk versions
# match the Hadoop client this exact Spark build ships (hadoop-client-api
# 3.3.4 -> hadoop-aws 3.3.x -> AWS SDK v1).
SPARK_VERSION=3.5.9-python3
ICEBERG_VERSION=1.6.1
SPARK_HADOOP_AWS_VERSION=3.3.4
SPARK_AWS_SDK_VERSION=1.12.367

# --- object storage (MinIO) ----------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# NOTE: if you rename the bucket, nothing else needs changing - the Hive
# metastore reads it from this variable via ${env.LAKEHOUSE_BUCKET}.
LAKEHOUSE_BUCKET=lakehouse
AWS_REGION=us-east-1

# --- Hive metastore backing database -------------------------------------
HMS_DB_NAME=metastore
HMS_DB_USER=hive
HMS_DB_PASSWORD=hive

# --- host port mappings ---------------------------------------------------
TRINO_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
HMS_PORT=9083
POSTGRES_PORT=5432
POLARIS_PORT=8181
POLARIS_MGMT_PORT=8182

# --- cluster sizing -------------------------------------------------------
TRINO_WORKERS=2

# --- materialized view refresh -------------------------------------------
# Trino has no scheduler; the mv-refresh service drives REFRESH on a loop.
# REFRESH_AT is wall-clock time in UTC+MV_REFRESH_UTC_OFFSET, so 08:00 with
# offset 8 means 08:00 Asia/Taipei (= 00:00 UTC). Fixed offset, no DST.
MV_REFRESH_AT=08:00
MV_REFRESH_UTC_OFFSET=8
# Space-separated, fully qualified. Add more as you create them.
MV_LIST=iceberg.reporting.events_daily_mv

# --- Polaris (optional profile) ------------------------------------------
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=s3cr3t
POLARIS_REALM=POLARIS
POLARIS_CATALOG=playground
